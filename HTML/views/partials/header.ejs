<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ImobiFácil</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header id="header">
<h1 id="logo"><a href="/">🏠 Imobi<span>Fácil</span></a></h1>
<nav id="menu">
<a href="/">Imóveis</a>
<a href="/?finalidade=venda">Comprar</a>
<a href="/?finalidade=aluguel">Alugar</a>
<a href="/#sobre">Sobre</a>
<% if (usuario) { %>
<a href="/formulario">Meu painel</a>
<a href="/logout" class="botao-menu">Sair</a>
<% } else { %>
<a href="/formulario" class="botao-menu">Área do corretor</a>
<% } %>
</nav>
</header>

<main id="conteudo">
<% if (mensagem) { %>
<p class="mensagem"><%= mensagem %></p>
<% } %>
